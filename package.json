{
  "name": "petsfirst",
  "version": "1.0.0",
  "main": "index.js",
  "description": "End-to-End Automation for Pets First with Enhanced HTML Reporting",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headed": "cypress run --headed --browser chrome",
    "merge-reports": "npx mochawesome-merge cypress/reports/*.json > cypress/reports/report.json",
    "generate-report": "npx marge cypress/reports/report.json --reportDir cypress/reports --inline",
    "open-report": "npx open-cli cypress/reports/report.html",
    "test:report": "npm run cypress:run:headed && npm run merge-reports && npm run generate-report && npm run open-report",
    "test": "npm run test:report"
  },
  "keywords": [
    "cypress",
    "automation",
    "mochawesome",
    "reports",
    "petsfirst"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^13.16.1",
    "cypress-mochawesome-reporter": "^3.8.2",
    "dotenv": "^17.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "nodemailer": "^7.0.5",
    "open-cli": "^7.0.1"
  },
  "dependencies": {
    "petsfirst": "file:"
  },
  "scripts": {
  "cypress:open": "cypress open",
  "cypress:run": "cypress run",
  "cypress:run:headed": "cypress run --headed --browser chrome",
  "merge-reports": "npx mochawesome-merge cypress/reports/*.json > cypress/reports/report.json",
  "generate-report": "npx marge cypress/reports/report.json --reportDir cypress/reports --inline",
  "open-report": "npx open-cli cypress/reports/report.html",
  "send-report": "node sendReport.js",
  "test:report": "npm run cypress:run:headed && npm run merge-reports && npm run generate-report && npm run send-report && npm run open-report",
  "test": "npm run test:report"
}

}
